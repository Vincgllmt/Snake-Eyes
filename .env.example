# Copie ce fichier en .env.
# Aucune clé API : Snake Eyes passe par Claude Code et ton abonnement Claude.

# Jeton d'abonnement pour Docker : lance `claude setup-token` sur ta machine et colle-le ici.
# (Inutile hors Docker si Claude Code est déjà connecté sur ta machine.)
CLAUDE_CODE_OAUTH_TOKEN=

# Optionnel
# SNAKE_EYES_MODEL=opus              # par défaut : le modèle par défaut de Claude Code
# Effort de réflexion : low | medium | high | xhigh | max. Plus il est élevé, plus Claude
# réfléchit avant de répondre (meilleur, mais bien plus de tokens consommés).
# SNAKE_EYES_EFFORT_MJ=medium        # Assistant MJ
# SNAKE_EYES_EFFORT_CREATION=medium  # Aide MJ
# SNAKE_EYES_EFFORT_JOUEUR=medium    # Aide joueurs
